# Student Task Manager — Environment Variables
# Copy this to .env and fill in your values

PORT=5000

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=student_task_manager

# JWT Secret — change this to a long random string in production!
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
